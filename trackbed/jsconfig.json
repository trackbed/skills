{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "skills/pr:code-review/scripts/review-execution.js",
    "hooks/lib/*.js",
    "scripts/check-installed-resources.js",
    "scripts/convert-plugin.js",
    "scripts/convert-plugin/**/*.js",
    "scripts/lib/*.js",
    "scripts/probe-cold-reader-isolation.js",
    "scripts/schemas/*.js",
    "scripts/skill-eval-compare.js",
    "scripts/skill-usage.js",
    "evals/review-completion/*.js",
    "evals/skill-review/*.js",
    "tests/node/*.test.js"
  ],
  "exclude": ["skills/pr:walkthrough/assets/d3.v7.9.0.min.js"]
}
