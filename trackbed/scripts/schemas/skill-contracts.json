{
  "schema_version": 1,
  "skill_frontmatter": {
    "fields": {
      "name": {
        "type": "string",
        "required": true
      },
      "description": {
        "type": "string",
        "required": true
      },
      "argument-hint": {
        "type": "string",
        "required": false,
        "loader_property": "argumentHint"
      },
      "disable-model-invocation": {
        "type": "boolean",
        "required": true,
        "loader_property": "disableModelInvocation"
      },
      "user-invocable": {
        "type": "boolean",
        "required": true,
        "loader_property": "userInvocable"
      },
      "trackbed-platforms": {
        "type": "string_array",
        "required": false,
        "loader_property": "platforms"
      }
    }
  },
  "source_manifest": {
    "required_fields": [
      "id",
      "title",
      "rationale",
      "usage",
      "last_reviewed_at",
      "baseline_hash"
    ],
    "one_of_fields": ["url", "context7_library"]
  },
  "agent_frontmatter": {
    "fields": {
      "name": {
        "type": "string",
        "required": true
      },
      "description": {
        "type": "text",
        "required": true
      },
      "model": {
        "type": "string",
        "required": true
      },
      "color": {
        "type": "string",
        "required": true
      },
      "tools": {
        "type": "tool_list",
        "required": false
      },
      "disallowedTools": {
        "type": "tool_list",
        "required": false
      },
      "capabilities": {
        "type": "text_array",
        "required": false
      },
      "omitClaudeMd": {
        "type": "boolean",
        "required": false
      }
    }
  }
}
